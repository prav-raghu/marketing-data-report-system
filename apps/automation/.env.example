DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"
PORT="4006"
NODE_ENV="development"
DOTNET_ENVIRONMENT=Development
CORS_ORIGIN="https://admin.randomsite.org"
# Sentry — leave empty to disable error monitoring (local dev)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# OpenObserve OTLP — start: docker compose -f devops/docker-compose.dev.yml up openobserve -d
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://localhost:5080/api/default/v1/logs"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:5080/api/default/v1/traces"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic REPLACE_WITH_BASE64_OF_EMAIL_COLON_PASSWORD"
