DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"
# Generate: openssl rand -hex 64
JWT_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET"
# Signs the short-lived MFA challenge token — must be a distinct secret from JWT_SECRET, generated the same way
MFA_CHALLENGE_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET"
REDIS_URL="https://redis.randomhost.io"
REDIS_TLS_REJECT_UNAUTHORIZED=false
REFRESH_TOKEN_EXPIRY="45m"
AUTH_TOKEN_EXPIRY="10m"
CORS_ORIGIN="https://frontend.randomsite.org"
RATE_LIMIT_WINDOW="20m"
RATE_LIMIT_MAX="150"
PORT="4001"
NODE_ENV="development"
DOTNET_ENVIRONMENT=Development
LOG_LEVEL="info"
MAILTRAP_API_KEY="your_mailtrap_api_key"
MAILTRAP_FROM="noreply@yourdomain.com"
MAILTRAP_FROM_NAME="Your App Name"
MAILTRAP_TEST_INBOX_ID=12345678
# OpenObserve OTLP — start: docker compose -f devops/docker-compose.dev.yml up openobserve -d
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://localhost:5080/api/default/v1/logs"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:5080/api/default/v1/traces"
# Basic auth — generate: echo -n "admin@example.com:Dev_password1!" | base64
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic REPLACE_WITH_BASE64_OF_EMAIL_COLON_PASSWORD"
# Sentry — leave empty to disable error monitoring (local dev)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# IP hashing — generate: openssl rand -hex 32
PEPPER="REPLACE_WITH_32_BYTE_HEX"
ADMIN_WEB_URL="http://localhost:4004"
PASSWORD_RESET_EXPIRATION_MINUTES="60"
# Generate: openssl rand -hex 64
JWT_REFRESH_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET"
# Generate: openssl rand -hex 32 (must be exactly 64 hex characters)
TWO_FACTOR_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_HEX_KEY_64_CHARS"
ACCOUNT_BAN_THRESHOLD=
