<div class="bg-white rounded-lg shadow-lg p-6 border-2 border-blue-500">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">🔢 Interactive WebAssembly Island</h2>
    <div class="flex flex-col items-center space-y-4">
        <div class="text-5xl font-bold text-blue-600">@_count</div>
        <div class="flex gap-2">
            <button @onclick="Decrement" class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600 transition-colors">
                - Decrement
            </button>
            <button @onclick="Reset" class="px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 transition-colors">
                Reset
            </button>
            <button @onclick="Increment" class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600 transition-colors">
                + Increment
            </button>
        </div>
        <p class="text-sm text-gray-600">✅ Rendered by this page's static SSR shell, hydrated to WebAssembly for interactivity</p>
    </div>
</div>

@code {
    private int _count;

    private void Increment() => _count++;
    private void Decrement() => _count--;
    private void Reset() => _count = 0;
}
