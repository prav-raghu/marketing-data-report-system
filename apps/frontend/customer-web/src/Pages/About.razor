@page "/about"

<PageTitle>About Us | Customer Web App</PageTitle>
<HeadContent>
    <meta name="description" content="Learn more about our company, mission, and values. This template demonstrates production-ready Next.js development." />
    <meta name="keywords" content="about, company, mission, values, team, next.js template" />
    <meta property="og:title" content="About Us | Customer Web App" />
    <meta property="og:description" content="Learn more about our company, mission, and values." />
    <meta property="og:url" content="https://example.com/about" />
    <meta property="og:image" content="https://example.com/og-about.jpg" />
</HeadContent>

<div class="min-h-screen bg-linear-to-br from-blue-50 to-indigo-100 py-12 px-4">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-xl p-8">
            <h1 class="text-4xl font-bold text-gray-800 mb-6">About This Template</h1>

            <div class="max-w-none">
                <p class="text-lg text-gray-700 mb-4">
                    This is a production-ready Blazor Web App template for the customer-facing web application.
                </p>

                <h2 class="text-2xl font-semibold text-gray-800 mt-6 mb-3">🚀 Tech Stack</h2>
                <ul class="space-y-2 text-gray-700">
                    <li class="flex items-center gap-2">
                        <span class="text-blue-500">🟣</span>
                        <strong>Blazor Web App</strong> - static SSR + WebAssembly hybrid render modes
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="text-cyan-500">🎨</span>
                        <strong>Tailwind CSS 4</strong> - Utility-first styling
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="text-pink-500">🧭</span>
                        <strong>Blazor Router</strong> - server-rendered page navigation
                    </li>
                </ul>

                <h2 class="text-2xl font-semibold text-gray-800 mt-6 mb-3">🧪 Router Test</h2>
                <p class="text-gray-700 mb-4">
                    You're currently on the <strong>About</strong> page. Server-rendered routing is working correctly!
                </p>
                <p class="text-sm text-gray-600 italic">
                    ✅ This page has no WebAssembly island — it's pure static SSR, same as the counter demo's page shell.
                </p>

                <div class="mt-8 flex gap-4">
                    <a href="/" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-md">
                        ← Back to Home
                    </a>
                    <a href="/nonexistent" class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors shadow-md">
                        Test 404 Page
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
