@page "/Error"

<PageTitle>Error</PageTitle>

<div class="min-h-screen bg-background flex items-center justify-center px-4">
    <div class="max-w-md w-full text-center">
        <h1 class="text-3xl font-bold text-foreground mb-2">Something went wrong</h1>
        <p class="text-muted-foreground mb-6">An unexpected error occurred. Please try again.</p>
        <a href="/" class="inline-block px-6 py-3 bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition-opacity">
            ← Back to Home
        </a>
    </div>
</div>
